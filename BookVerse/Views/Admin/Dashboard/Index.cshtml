@model BookVerse.Models.ViewModels.Admin.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
    ViewData["ActiveMenu"] = "Dashboard";

    string FormatCurrency(decimal amount) => amount.ToString("N0") + " ₫";
    string ChangeClass(double val) => val >= 0 ? "positive" : "negative";
    string ChangeIcon(double val) => val >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right";
    string FormatChange(double val) => (val >= 0 ? "+" : "") + val.ToString("F1") + "%";
}

<!-- ===== STAT CARDS ===== -->
<div class="stat-cards-grid">
    <!-- Doanh thu -->
    <div class="stat-card revenue">
        <div class="stat-card-header">
            <span class="stat-card-label">Doanh thu tháng này</span>
            <div class="stat-card-icon"><i class="bi bi-currency-dollar"></i></div>
        </div>
        <div class="stat-card-value">@FormatCurrency(Model.TotalRevenue)</div>
        <div class="stat-card-change @ChangeClass(Model.RevenueChangePercent)">
            <i class="bi @ChangeIcon(Model.RevenueChangePercent)"></i>
            <span>@FormatChange(Model.RevenueChangePercent) so với tháng trước</span>
        </div>
    </div>

    <!-- Đơn hàng -->
    <div class="stat-card orders">
        <div class="stat-card-header">
            <span class="stat-card-label">Tổng đơn hàng</span>
            <div class="stat-card-icon"><i class="bi bi-bag-check"></i></div>
        </div>
        <div class="stat-card-value">@Model.TotalOrders.ToString("N0")</div>
        <div class="stat-card-change @ChangeClass(Model.OrdersChangePercent)">
            <i class="bi @ChangeIcon(Model.OrdersChangePercent)"></i>
            <span>@FormatChange(Model.OrdersChangePercent) so với tháng trước</span>
        </div>
    </div>

    <!-- Sách đã bán -->
    <div class="stat-card books">
        <div class="stat-card-header">
            <span class="stat-card-label">Sách đã bán</span>
            <div class="stat-card-icon"><i class="bi bi-book"></i></div>
        </div>
        <div class="stat-card-value">@Model.TotalBooksSold.ToString("N0")</div>
        <div class="stat-card-change @ChangeClass(Model.BooksSoldChangePercent)">
            <i class="bi @ChangeIcon(Model.BooksSoldChangePercent)"></i>
            <span>@FormatChange(Model.BooksSoldChangePercent) so với tháng trước</span>
        </div>
    </div>

    <!-- Người dùng mới -->
    <div class="stat-card users">
        <div class="stat-card-header">
            <span class="stat-card-label">Người dùng mới</span>
            <div class="stat-card-icon"><i class="bi bi-person-plus"></i></div>
        </div>
        <div class="stat-card-value">@Model.NewUsers.ToString("N0")</div>
        <div class="stat-card-change @ChangeClass(Model.UsersChangePercent)">
            <i class="bi @ChangeIcon(Model.UsersChangePercent)"></i>
            <span>@FormatChange(Model.UsersChangePercent) so với tháng trước</span>
        </div>
    </div>
</div>

<!-- ===== CHARTS ROW ===== -->
<div class="charts-grid">
    <!-- Revenue Line Chart -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h3 class="admin-card-title">
                <i class="bi bi-graph-up-arrow"></i>
                Doanh thu 30 ngày gần nhất
            </h3>
        </div>
        <div class="admin-card-body">
            <div class="chart-container">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Category Pie Chart -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h3 class="admin-card-title">
                <i class="bi bi-pie-chart"></i>
                Doanh thu theo danh mục
            </h3>
        </div>
        <div class="admin-card-body">
            <div class="chart-container">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ===== TOP BOOKS BAR CHART ===== -->
<div class="admin-card mb-4">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="bi bi-trophy"></i>
            Top 5 sách bán chạy nhất
        </h3>
    </div>
    <div class="admin-card-body">
        <div class="chart-container" style="height: 220px">
            <canvas id="topBooksChart"></canvas>
        </div>
    </div>
</div>

<!-- ===== RECENT ORDERS TABLE ===== -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="bi bi-clock-history"></i>
            10 đơn hàng gần đây
        </h3>
        <a href="/Admin/Orders" class="btn btn-secondary btn-sm">Xem tất cả</a>
    </div>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#Mã ĐH</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>SL sản phẩm</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái đơn</th>
                    <th>Thanh toán</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentOrders.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Chưa có đơn hàng nào
                        </td>
                    </tr>
                }
                @foreach (var order in Model.RecentOrders)
                {
                    var statusClass = order.Status switch
                    {
                        "Chờ xử lý" => "status-cho-xu-ly",
                        "Đang giao" => "status-dang-giao",
                        "Đã giao" => "status-da-giao",
                        "Đã hủy" => "status-da-huy",
                        _ => "status-cho-xu-ly"
                    };
                    var paymentClass = (order.PaymentStatus?.Contains("Đã") == true || order.PaymentStatus?.Contains("thanh toán") == true && !order.PaymentStatus.Contains("Chưa")) ? "payment-da" : "payment-chua";
                    <tr>
                        <td>
                            <span class="fw-600 text-accent">#@order.OrderId</span>
                        </td>
                        <td>
                            <div class="fw-500" style="color: var(--color-text-primary)">@order.CustomerName</div>
                        </td>
                        <td>@order.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.ItemCount quyển</td>
                        <td class="fw-600" style="color: var(--color-gold)">@FormatCurrency(order.TotalAmount)</td>
                        <td><span class="status-badge @statusClass">@order.Status</span></td>
                        <td><span class="status-badge @paymentClass">@order.PaymentStatus</span></td>
                        <td>
                            <a href="/Admin/Orders/Detail/@order.OrderId" class="btn-action btn-action-view" title="Xem chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const chartDefaults = {
        color: 'rgba(160,174,192,0.8)',
        plugins: {
            legend: { labels: { color: 'rgba(160,174,192,0.9)', font: { family: 'Inter', size: 12 } } },
            tooltip: {
                backgroundColor: '#16213e',
                borderColor: 'rgba(255,255,255,0.1)',
                borderWidth: 1,
                titleColor: '#fff',
                bodyColor: 'rgba(160,174,192,0.9)',
                padding: 10
            }
        },
        scales: {
            x: { ticks: { color: 'rgba(160,174,192,0.7)', font: { size: 11 } }, grid: { color: 'rgba(255,255,255,0.05)' } },
            y: { ticks: { color: 'rgba(160,174,192,0.7)', font: { size: 11 } }, grid: { color: 'rgba(255,255,255,0.05)' } }
        }
    };

    // Revenue Line Chart
    const revenueDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueDates));
    const revenueAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueAmounts));

    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: revenueDates,
            datasets: [{
                label: 'Doanh thu (₫)',
                data: revenueAmounts,
                borderColor: '#e94560',
                backgroundColor: 'rgba(233,69,96,0.08)',
                borderWidth: 2.5,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#e94560',
                pointRadius: 3,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: {
                ...chartDefaults.plugins,
                tooltip: {
                    ...chartDefaults.plugins.tooltip,
                    callbacks: {
                        label: ctx => ' ' + Number(ctx.raw).toLocaleString('vi-VN') + ' ₫'
                    }
                }
            },
            scales: chartDefaults.scales
        }
    });

    // Category Pie Chart
    const catNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryNames));
    const catRevs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues));
    const pieColors = ['#e94560','#f5a623','#63b3ed','#48bb78','#9f7aea','#fc8181'];

    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
            labels: catNames.length > 0 ? catNames : ['Chưa có dữ liệu'],
            datasets: [{
                data: catRevs.length > 0 ? catRevs : [1],
                backgroundColor: pieColors,
                borderColor: '#16213e',
                borderWidth: 3,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            cutout: '62%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { color: 'rgba(160,174,192,0.9)', font: { family: 'Inter', size: 11 }, padding: 12, boxWidth: 12 }
                },
                tooltip: {
                    ...chartDefaults.plugins.tooltip,
                    callbacks: {
                        label: ctx => ' ' + Number(ctx.raw).toLocaleString('vi-VN') + ' ₫'
                    }
                }
            }
        }
    });

    // Top 5 Books Bar Chart
    const bookTitles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopBooks.Select(b => b.Title.Length > 20 ? b.Title.Substring(0, 20) + "..." : b.Title).ToList()));
    const bookSolds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopBooks.Select(b => b.TotalSold).ToList()));

    new Chart(document.getElementById('topBooksChart'), {
        type: 'bar',
        data: {
            labels: bookTitles.length > 0 ? bookTitles : ['Chưa có dữ liệu'],
            datasets: [{
                label: 'Số lượng bán',
                data: bookSolds.length > 0 ? bookSolds : [0],
                backgroundColor: ['#e94560','#f5a623','#63b3ed','#48bb78','#9f7aea'],
                borderRadius: 8,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            indexAxis: 'y',
            plugins: {
                ...chartDefaults.plugins,
                legend: { display: false }
            },
            scales: {
                x: { ...chartDefaults.scales.x, beginAtZero: true },
                y: { ...chartDefaults.scales.y }
            }
        }
    });
</script>
}
