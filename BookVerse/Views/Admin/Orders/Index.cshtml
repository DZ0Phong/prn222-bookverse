@model BookVerse.Models.ViewModels.Admin.OrderListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đơn hàng";
    ViewData["ActiveMenu"] = "Orders";
    string FormatCurrency(decimal p) => p.ToString("N0") + " ₫";

    var tabs = new[]
    {
        new { Label = "Tất cả", Value = "", Count = Model.CountAll },
        new { Label = "Chờ xử lý", Value = "Chờ xử lý", Count = Model.CountPending },
        new { Label = "Đang giao", Value = "Đang giao", Count = Model.CountShipping },
        new { Label = "Đã giao", Value = "Đã giao", Count = Model.CountDelivered },
        new { Label = "Đã hủy", Value = "Đã hủy", Count = Model.CountCancelled },
    };
}

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="bi bi-cart3 me-2 text-accent"></i>Quản lý đơn hàng</h1>
        <p>Tổng cộng <strong class="text-accent">@Model.TotalCount</strong> đơn hàng</p>
    </div>
</div>

<!-- Status Tabs -->
<div class="admin-card mb-0" style="border-bottom-left-radius:0;border-bottom-right-radius:0;border-bottom:none">
    <div style="display:flex;gap:0;overflow-x:auto">
        @foreach (var tab in tabs)
        {
            var isActive = Model.StatusFilter == tab.Value || (tab.Value == "" && string.IsNullOrEmpty(Model.StatusFilter));
            <a href="/Admin/Orders?status=@tab.Value&search=@Model.SearchTerm&fromDate=@Model.FromDate&toDate=@Model.ToDate"
               style="padding:0.875rem 1.25rem;border-bottom:2px solid @(isActive ? "var(--color-accent)" : "transparent");color:@(isActive ? "var(--color-accent)" : "var(--color-text-muted)");font-weight:@(isActive ? "700" : "500");font-size:0.9rem;text-decoration:none;white-space:nowrap;display:flex;align-items:center;gap:0.4rem;transition:all 0.2s">
                @tab.Label
                <span style="background:@(isActive ? "var(--color-accent)" : "rgba(255,255,255,0.08)");color:@(isActive ? "white" : "var(--color-text-muted)");border-radius:12px;padding:0.1rem 0.55rem;font-size:0.75rem;font-weight:600">
                    @tab.Count
                </span>
            </a>
        }
    </div>
</div>

<div class="admin-card" style="border-top-left-radius:0;border-top-right-radius:0">
    <!-- Filter Bar -->
    <form method="get" action="/Admin/Orders">
        <input type="hidden" name="status" value="@Model.StatusFilter" />
        <div class="filter-bar">
            <div class="search-input-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="form-control search-input"
                       placeholder="Tìm mã đơn, tên/email khách..."
                       value="@Model.SearchTerm" />
            </div>

            <div style="display:flex;align-items:center;gap:0.5rem">
                <label class="text-muted" style="font-size:0.875rem;white-space:nowrap">Từ ngày</label>
                <input type="date" name="fromDate" class="form-control" style="max-width:160px" value="@Model.FromDate" />
            </div>
            <div style="display:flex;align-items:center;gap:0.5rem">
                <label class="text-muted" style="font-size:0.875rem;white-space:nowrap">Đến ngày</label>
                <input type="date" name="toDate" class="form-control" style="max-width:160px" value="@Model.ToDate" />
            </div>

            <button type="submit" class="btn btn-secondary btn-sm">
                <i class="bi bi-funnel"></i> Lọc
            </button>

            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.FromDate) || !string.IsNullOrEmpty(Model.ToDate))
            {
                <a href="/Admin/Orders?status=@Model.StatusFilter" class="btn btn-sm" style="background:rgba(255,255,255,0.05);color:var(--color-text-muted)">
                    <i class="bi bi-x"></i> Xóa lọc
                </a>
            }
        </div>
    </form>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#Mã ĐH</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>SL</th>
                    <th>Tổng tiền</th>
                    <th>PT thanh toán</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th>Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5">
                            <i class="bi bi-inbox" style="font-size:2rem;color:var(--color-text-muted);display:block;margin-bottom:0.75rem"></i>
                            <span class="text-muted">Không có đơn hàng nào</span>
                        </td>
                    </tr>
                }
                @foreach (var order in Model.Orders)
                {
                    var statusClass = order.Status switch
                    {
                        "Chờ xử lý" => "status-cho-xu-ly",
                        "Đang giao" => "status-dang-giao",
                        "Đã giao" => "status-da-giao",
                        "Đã hủy" => "status-da-huy",
                        _ => "status-cho-xu-ly"
                    };
                    var paymentClass = (order.PaymentStatus?.Contains("Đã") == true) ? "payment-da" : "payment-chua";
                    <tr>
                        <td><span class="fw-600 text-accent">#@order.OrderId</span></td>
                        <td>
                            <div class="fw-600" style="color:var(--color-text-primary)">@order.CustomerName</div>
                            <div style="font-size:0.8rem;color:var(--color-text-muted)">@order.CustomerEmail</div>
                        </td>
                        <td>@order.CreatedAt?.ToString("dd/MM/yyyy")<br/><span style="font-size:0.8rem;color:var(--color-text-muted)">@order.CreatedAt?.ToString("HH:mm")</span></td>
                        <td>@order.ItemCount</td>
                        <td class="fw-600 text-gold">@FormatCurrency(order.TotalAmount)</td>
                        <td>@order.PaymentMethod</td>
                        <td><span class="status-badge @paymentClass">@order.PaymentStatus</span></td>
                        <td><span class="status-badge @statusClass">@order.Status</span></td>
                        <td>
                            <a href="/Admin/Orders/Detail/@order.OrderId" class="btn-action btn-action-view" title="Xem chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="admin-pagination">
            <div class="pagination-info">
                Hiển thị @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) trong @Model.TotalCount kết quả
            </div>
            <div class="pagination-links">
                @if (Model.CurrentPage > 1)
                {
                    <a href="?status=@Model.StatusFilter&search=@Model.SearchTerm&fromDate=@Model.FromDate&toDate=@Model.ToDate&page=@(Model.CurrentPage - 1)" class="page-btn"><i class="bi bi-chevron-left"></i></a>
                }
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <a href="?status=@Model.StatusFilter&search=@Model.SearchTerm&fromDate=@Model.FromDate&toDate=@Model.ToDate&page=@i"
                       class="page-btn @(i == Model.CurrentPage ? "active" : "")">@i</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="?status=@Model.StatusFilter&search=@Model.SearchTerm&fromDate=@Model.FromDate&toDate=@Model.ToDate&page=@(Model.CurrentPage + 1)" class="page-btn"><i class="bi bi-chevron-right"></i></a>
                }
            </div>
        </div>
    }
</div>
