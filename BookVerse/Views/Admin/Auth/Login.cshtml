@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập Admin - @SiteOptions.Value.BrandName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
<div class="admin-login-page">
    <div class="login-card">
        <!-- Logo -->
        <div class="login-logo">
            <div class="login-logo-icon">
                <i class="bi bi-book-half"></i>
            </div>
        </div>

        <h1 class="login-title">Chào mừng trở lại!</h1>
        <p class="login-subtitle">Đăng nhập vào trang quản trị <strong class="text-accent">@SiteOptions.Value.BrandName</strong></p>

        <!-- Alert Error -->
        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert alert-danger mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <!-- Alert Success (for redirects) -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        <!-- Login Form -->
        <form method="post" action="/Admin/Auth/Login" id="loginForm">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="form-label" for="email">
                    <i class="bi bi-envelope me-1"></i>Địa chỉ Email
                </label>
                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       placeholder="admin@bookverse.vn"
                       required
                       autocomplete="email" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="password">
                    <i class="bi bi-lock me-1"></i>Mật khẩu
                </label>
                <div class="position-relative">
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           placeholder="••••••••"
                           required
                           autocomplete="current-password"
                           style="padding-right: 3rem" />
                    <button type="button"
                            class="btn-action position-absolute top-50 end-0 translate-middle-y me-2"
                            onclick="togglePassword()"
                            title="Hiện/ẩn mật khẩu"
                            style="background: transparent; color: var(--color-text-muted)">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg" id="loginBtn">
                <i class="bi bi-shield-lock"></i>
                Đăng nhập
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/" class="text-muted" style="font-size: 0.875rem">
                <i class="bi bi-arrow-left me-1"></i>Quay về trang chủ
            </a>
        </div>

        <div class="text-center mt-3">
            <small class="text-muted">
                Chỉ tài khoản có quyền <strong class="text-accent">Admin</strong> mới có thể đăng nhập
            </small>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function togglePassword() {
        const input = document.getElementById('password');
        const icon = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }

    // Loading state on form submit
    document.getElementById('loginForm').addEventListener('submit', function () {
        const btn = document.getElementById('loginBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang đăng nhập...';
    });
</script>
<script src="~/js/localization.js" asp-append-version="true"></script>
</body>
</html>
