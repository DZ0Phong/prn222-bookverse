@model BookVerse.Models.ViewModels.Admin.BookListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý sách";
    ViewData["ActiveMenu"] = "Books";
    string FormatCurrency(decimal? p) => (p ?? 0).ToString("N0") + " ₫";
}

<!-- Alert Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4"><i class="bi bi-check-circle-fill"></i><span>@TempData["Success"]</span></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4"><i class="bi bi-x-circle-fill"></i><span>@TempData["Error"]</span></div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning mb-4"><i class="bi bi-exclamation-triangle-fill"></i><span>@TempData["Warning"]</span></div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1><i class="bi bi-book me-2 text-accent"></i>Quản lý sách</h1>
        <p>Tổng cộng <strong class="text-accent">@Model.TotalCount</strong> sách trong hệ thống</p>
    </div>
    <a href="/Admin/Books/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Thêm sách mới
    </a>
</div>

<!-- Main Card -->
<div class="admin-card">
    <!-- Filter Bar -->
    <form method="get" action="/Admin/Books" id="filterForm">
        <div class="filter-bar">
            <div class="search-input-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="form-control search-input"
                       placeholder="Tìm theo tên sách, tác giả..."
                       value="@Model.SearchTerm" />
            </div>

            <select name="categoryId" class="form-select" style="max-width: 200px"
                    onchange="document.getElementById('filterForm').submit()">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryId" selected="@(Model.FilterCategoryId == cat.CategoryId)">
                        @cat.CategoryName
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-secondary btn-sm">
                <i class="bi bi-funnel"></i> Lọc
            </button>

            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.FilterCategoryId.HasValue)
            {
                <a href="/Admin/Books" class="btn btn-sm" style="background: rgba(255,255,255,0.05); color: var(--color-text-muted)">
                    <i class="bi bi-x"></i> Xóa lọc
                </a>
            }
        </div>
    </form>

    <!-- Table -->
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 56px">Ảnh</th>
                    <th>Tên sách</th>
                    <th>Tác giả</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th style="width: 120px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Books.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <i class="bi bi-search" style="font-size: 2rem; color: var(--color-text-muted); display:block; margin-bottom:0.75rem"></i>
                            <span class="text-muted">Không tìm thấy sách nào</span>
                        </td>
                    </tr>
                }
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(book.Image))
                            {
                                <img src="@book.Image" alt="@book.Title" class="book-thumb" />
                            }
                            else
                            {
                                <div class="book-thumb-placeholder"><i class="bi bi-book"></i></div>
                            }
                        </td>
                        <td>
                            <div class="fw-600" style="color: var(--color-text-primary); max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis" title="@book.Title">
                                @book.Title
                            </div>
                        </td>
                        <td>@book.Author</td>
                        <td>
                            <span class="badge badge-info">@book.CategoryName</span>
                        </td>
                        <td class="fw-600 text-gold">@FormatCurrency(book.Price)</td>
                        <td>
                            @if (book.Quantity < 10)
                            {
                                <span class="fw-600" style="color: var(--color-danger)">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@book.Quantity
                                </span>
                            }
                            else
                            {
                                <span>@book.Quantity</span>
                            }
                        </td>
                        <td>
                            <!-- Toggle Active -->
                            <label class="toggle-switch" title="@(book.IsActive == true ? "Đang hiển thị" : "Đang ẩn")">
                                <input type="checkbox"
                                       @(book.IsActive == true ? "checked" : "")
                                       onchange="toggleActive(@book.BookId, this)" />
                                <span class="toggle-slider"></span>
                            </label>
                        </td>
                        <td>
                            <div class="table-actions">
                                <a href="/Admin/Books/Edit/@book.BookId"
                                   class="btn-action btn-action-edit" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button"
                                        class="btn-action btn-action-delete"
                                        title="@(book.HasOrders ? "Ẩn sách (đã có đơn hàng)" : "Xóa sách")"
                                        onclick="confirmDelete(@book.BookId, '@book.Title?.Replace("'","\\'")', @(book.HasOrders ? "true" : "false"))">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="admin-pagination">
            <div class="pagination-info">
                Hiển thị @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))
                trong @Model.TotalCount kết quả
            </div>
            <div class="pagination-links">
                @if (Model.CurrentPage > 1)
                {
                    <a href="?search=@Model.SearchTerm&categoryId=@Model.FilterCategoryId&page=@(Model.CurrentPage - 1)" class="page-btn">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <a href="?search=@Model.SearchTerm&categoryId=@Model.FilterCategoryId&page=@i"
                       class="page-btn @(i == Model.CurrentPage ? "active" : "")">@i</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="?search=@Model.SearchTerm&categoryId=@Model.FilterCategoryId&page=@(Model.CurrentPage + 1)" class="page-btn">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade admin-modal" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-trash me-2 text-accent"></i>Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteMessage" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-trash me-1"></i>Xác nhận
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleActive(bookId, checkbox) {
        fetch(`/Admin/Books/ToggleActive`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
            body: JSON.stringify({ id: bookId })
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                checkbox.checked = !checkbox.checked;
                alert('Có lỗi xảy ra!');
            }
        })
        .catch(() => { checkbox.checked = !checkbox.checked; });
    }

    function confirmDelete(bookId, title, hasOrders) {
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const msg = document.getElementById('deleteMessage');
        const form = document.getElementById('deleteForm');

        if (hasOrders) {
            msg.innerHTML = `Sách <strong>"${title}"</strong> đã có trong đơn hàng.<br>Sách sẽ được <strong>ẩn</strong> thay vì xóa hoàn toàn. Tiếp tục?`;
        } else {
            msg.innerHTML = `Bạn có chắc muốn <strong>xóa vĩnh viễn</strong> sách <strong>"${title}"</strong>?<br><span class="text-muted" style="font-size:0.875rem">Thao tác này không thể hoàn tác.</span>`;
        }

        form.action = `/Admin/Books/Delete/${bookId}`;
        modal.show();
    }
</script>
}
