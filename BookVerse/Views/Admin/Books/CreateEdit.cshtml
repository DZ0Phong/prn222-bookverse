@model BookVerse.Models.ViewModels.Admin.BookFormViewModel
@{
    Layout = "_AdminLayout";
    bool isEdit = Model.BookId > 0;
    ViewData["Title"] = isEdit ? "Chỉnh sửa sách" : "Thêm sách mới";
    ViewData["ActiveMenu"] = "Books";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1>
            <i class="bi bi-@(isEdit ? "pencil-square" : "plus-circle") me-2 text-accent"></i>
            @ViewData["Title"]
        </h1>
        <p>@(isEdit ? "Cập nhật thông tin sách trong hệ thống" : "Thêm sách mới vào danh mục bán hàng")</p>
    </div>
    <a href="/Admin/Books" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<form method="post" enctype="multipart/form-data"
      action="@(isEdit ? $"/Admin/Books/Edit/{Model.BookId}" : "/Admin/Books/Create")"
      id="bookForm">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- Left Column: Main Info -->
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title"><i class="bi bi-info-circle"></i>Thông tin sách</h3>
                </div>
                <div class="admin-card-body">

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label">
                            Tên sách <span class="text-accent">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tên sách..." />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Author" class="form-label">
                                Tác giả <span class="text-accent">*</span>
                            </label>
                            <input asp-for="Author" class="form-control" placeholder="Tên tác giả..." />
                            <span asp-validation-for="Author" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Publisher" class="form-label">Nhà xuất bản</label>
                            <input asp-for="Publisher" class="form-control" placeholder="NXB..." />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label">
                            Danh mục <span class="text-accent">*</span>
                        </label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="0">-- Chọn danh mục --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label">
                                Giá bán (₫) <span class="text-accent">*</span>
                            </label>
                            <div class="position-relative">
                                <input asp-for="Price" type="number" class="form-control"
                                       placeholder="79000" min="1000" step="1000" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="form-label">Số lượng tồn kho</label>
                            <input asp-for="Quantity" type="number" class="form-control"
                                   placeholder="0" min="0" />
                            <span asp-validation-for="Quantity" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Mô tả sách</label>
                        <textarea asp-for="Description" class="form-control"
                                  rows="6" placeholder="Mô tả nội dung, tác giả, độc giả phù hợp..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Image & Settings -->
        <div class="col-lg-4">
            <!-- Image Upload -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <h3 class="admin-card-title"><i class="bi bi-image"></i>Ảnh bìa sách</h3>
                </div>
                <div class="admin-card-body">
                    <!-- Preview -->
                    <div class="text-center mb-3" id="imagePreviewWrapper">
                        @if (!string.IsNullOrEmpty(Model.ExistingImage))
                        {
                            <img id="imagePreview" src="@Model.ExistingImage" alt="Ảnh bìa"
                                 style="width:100%;max-height:250px;object-fit:contain;border-radius:var(--radius-md);background:rgba(255,255,255,0.03);" />
                        }
                        else
                        {
                            <div id="imagePlaceholder" style="height:200px;background:rgba(255,255,255,0.03);border-radius:var(--radius-md);display:flex;flex-direction:column;align-items:center;justify-content:center;border:2px dashed rgba(255,255,255,0.1)">
                                <i class="bi bi-cloud-upload" style="font-size:2.5rem;color:var(--color-text-muted)"></i>
                                <span class="text-muted mt-2">Chưa có ảnh</span>
                            </div>
                            <img id="imagePreview" src="" alt="" style="display:none;width:100%;max-height:250px;object-fit:contain;border-radius:var(--radius-md);" />
                        }
                    </div>

                    <label class="form-label">
                        @(string.IsNullOrEmpty(Model.ExistingImage) ? "Tải ảnh lên" : "Thay ảnh mới")
                    </label>
                    <input type="file" name="ImageFile" id="imageFile" class="form-control"
                           accept="image/*" onchange="previewImage(this)" />
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1"></i>
                        JPG, PNG, WEBP — Tối đa 5MB
                    </small>
                    <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <!-- Settings -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title"><i class="bi bi-gear"></i>Cài đặt</h3>
                </div>
                <div class="admin-card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-600" style="color:var(--color-text-primary)">Hiển thị sách</div>
                            <small class="text-muted">Cho phép khách hàng xem sách này</small>
                        </div>
                        <label class="toggle-switch">
                            <input asp-for="IsActive" type="checkbox" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <hr style="border-color: var(--color-border); margin: 1.25rem 0" />

                    <button type="submit" class="btn btn-primary w-100" id="submitBtn">
                        <i class="bi bi-check-lg me-1"></i>
                        @(isEdit ? "Lưu thay đổi" : "Thêm sách")
                    </button>
                    <a href="/Admin/Books" class="btn btn-secondary w-100 mt-2">
                        Hủy
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    function previewImage(input) {
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('imagePlaceholder');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                preview.src = e.target.result;
                preview.style.display = 'block';
                if (placeholder) placeholder.style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    document.getElementById('bookForm').addEventListener('submit', function () {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
    });
</script>
}
