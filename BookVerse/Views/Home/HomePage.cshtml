    <!-- FAB for Quick Scroll -->
    <button class="fixed bottom-8 right-8 w-12 h-12 bg-primary text-white rounded-full shadow-lg flex items-center justify-center hover:scale-110 transition-transform z-40 border-none" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
        <span class="material-symbols-outlined">expand_less</span>
    </button>
    <script>
        // Micro-interactions and scroll effects
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (header) {
                if (window.scrollY > 20) {
                    header.classList.add('shadow-md');
                } else {
                    header.classList.remove('shadow-md');
                }
            }
        });

        // Search bar interaction
        const searchInput = document.querySelector('input[name="search"]');
        if (searchInput) {
            searchInput.addEventListener('focus', () => {
                searchInput.parentElement.classList.add('scale-[1.02]');
            });
            searchInput.addEventListener('blur', () => {
                searchInput.parentElement.classList.remove('scale-[1.02]');
            });
        }
        
        // Close user dropdown when clicking outside
        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('userDropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                document.getElementById('userMenu')?.classList.add('hidden');
            }
        });

        // Book Modal Controls
        const modal = document.getElementById('bookDetailModal');
        const modalContent = modal.querySelector('.bg-white');
        
        function openBookModal(book) {
            document.getElementById('modalBookImage').src = book.image;
            document.getElementById('modalBookCategory').innerText = book.category;
            document.getElementById('modalBookTitle').innerText = book.title;
            document.getElementById('modalBookAuthor').innerText = book.author;
            document.getElementById('modalBookPublisher').innerText = book.publisher;
            document.getElementById('modalBookDescription').innerText = book.description;
            document.getElementById('modalBookPrice').innerText = book.price + 'đ';
            
            const statusEl = document.getElementById('modalBookStatus');
            if (book.quantity > 0) {
                statusEl.innerText = 'Còn hàng (' + book.quantity + ')';
                statusEl.className = 'font-bold text-secondary text-body-md';
                document.getElementById('modalAddToCartBtn').disabled = false;
                document.getElementById('modalAddToCartBtn').className = 'w-full bg-secondary text-white py-3 rounded-xl font-bold hover:bg-secondary-container hover:text-on-secondary-container transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg border-none';
            } else {
                statusEl.innerText = 'Hết hàng';
                statusEl.className = 'font-bold text-error text-body-md';
                document.getElementById('modalAddToCartBtn').disabled = true;
                document.getElementById('modalAddToCartBtn').className = 'w-full bg-outline text-white py-3 rounded-xl font-bold cursor-not-allowed flex items-center justify-center gap-2 border-none';
            }
            
            document.getElementById('modalAddToCartBtn').onclick = () => {
                addToCart(book.id);
                closeBookModal();
            };

            // --- ĐOẠN ĐƯỢC THÊM MỚI: Cập nhật Link cho nút Xem Chi Tiết ---
            const viewDetailBtn = document.getElementById('modalViewDetailBtn');
            if (viewDetailBtn) {
                viewDetailBtn.href = '/User/Book/Detail/' + book.id;
            }
            // -------------------------------------------------------------
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.classList.add('opacity-100');
                modalContent.classList.remove('translate-y-4', 'scale-95');
                modalContent.classList.add('translate-y-0', 'scale-100');
            }, 50);
        }
        
        function closeBookModal() {
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            modalContent.classList.remove('translate-y-0', 'scale-100');
            modalContent.classList.add('translate-y-4', 'scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
        
        // Close modal when clicking outside
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeBookModal();
            }
        });
        
        // Connect event listeners to book cards
        document.querySelectorAll('.book-card').forEach(card => {
            card.addEventListener('click', () => {
                const id = card.getAttribute('data-id');
                const title = card.getAttribute('data-title');
                const author = card.getAttribute('data-author');
                const category = card.getAttribute('data-category');
                const publisher = card.getAttribute('data-publisher');
                const price = card.getAttribute('data-price');
                const image = card.getAttribute('data-image');
                const quantity = parseInt(card.getAttribute('data-quantity') || '0');
                const description = card.getAttribute('data-description') || 'Chưa có mô tả chi tiết cho cuốn sách này.';
                
                openBookModal({ id, title, author, category, publisher, price, image, quantity, description });
            });
        });
        
        // Add to Cart helper
        function addToCart(bookId) {
            alert('Đã thêm sách vào giỏ hàng thành công!');
        }
    </script>
    <form id="global-antiforgery" class="d-none">@Html.AntiForgeryToken()</form>
    <script>
        async function addToCart(bookId) {
            const token = document.querySelector('#global-antiforgery input[name="__RequestVerificationToken"]').value;
            const body = new URLSearchParams({ bookId: bookId, quantity: 1, __RequestVerificationToken: token });
            const response = await fetch('/Cart/Add', { method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' }, body });
            if (response.redirected) { location.href = response.url; return; }
            const result = await response.json();
            if (result.success) {
                const badge = document.getElementById('header-cart-count');
                if (badge) badge.textContent = result.count;
            }
            alert(result.success ? 'Đã thêm sách vào giỏ hàng.' : 'Không thể thêm vào giỏ hàng.');
        }
    </script>
    <script src="~/js/localization.js" asp-append-version="true"></script>
    <script>fetch('/Cart/Count').then(r => r.json()).then(x => { const el = document.getElementById('header-cart-count'); if (el) el.textContent = x.count; }).catch(() => {});</script>
    <script>
        (() => {
            const nav = document.getElementById('home-section-nav');
            const indicator = document.getElementById('home-nav-indicator');
            if (!nav || !indicator) return;
            const links = [...nav.querySelectorAll('[data-home-section]')];

            function activate(section) {
                const active = links.find(link => link.dataset.homeSection === section) || links[0];
                links.forEach(link => {
                    const selected = link === active;
                    link.classList.toggle('text-primary', selected);
                    link.classList.toggle('font-bold', selected);
                    link.classList.toggle('text-on-surface-variant', !selected);
                    if (selected) link.setAttribute('aria-current', 'page');
                    else link.removeAttribute('aria-current');
                });
                indicator.style.width = active.offsetWidth + 'px';
                indicator.style.transform = `translateX(${active.offsetLeft}px)`;
            }

            links.forEach(link => link.addEventListener('click', event => {
                event.preventDefault();
                const section = link.dataset.homeSection;
                activate(section);
                if (section === 'home') {
                    history.pushState(null, '', '/Home/HomePage');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    history.pushState(null, '', '#' + section);
                    document.getElementById(section)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }));

            const observer = new IntersectionObserver(entries => {
                const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
                if (visible) activate(visible.target.id);
            }, { rootMargin: '-20% 0px -60% 0px', threshold: [0, 0.1, 0.5] });
            ['new-arrivals', 'promotions', 'bestsellers'].forEach(id => {
                const section = document.getElementById(id);
                if (section) observer.observe(section);
            });

            window.addEventListener('scroll', () => { if (window.scrollY < 160) activate('home'); }, { passive: true });
            window.addEventListener('resize', () => activate(location.hash.slice(1) || (window.scrollY < 160 ? 'home' : links.find(x => x.getAttribute('aria-current'))?.dataset.homeSection)), { passive: true });
            requestAnimationFrame(() => activate(location.hash.slice(1) || 'home'));
        })();
    </script>
</body>
</html>
