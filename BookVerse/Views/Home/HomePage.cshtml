@{
    Layout = null;
}
<!DOCTYPE html>

<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@SiteOptions.Value.BrandName | Trang chủ</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .filled-icon {
            font-variation-settings: 'FILL' 1;
        }
        .book-card-hover:hover .add-to-cart-btn {
            opacity: 1;
            transform: translateY(0);
        }
        .glass-effect {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(8px);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container": "#eaedff",
                        "background": "#faf8ff",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-secondary-fixed": "#002117",
                        "surface-variant": "#dae2fd",
                        "surface-container-lowest": "#ffffff",
                        "primary-container": "#2c3e90",
                        "surface-dim": "#d2d9f4",
                        "on-secondary-fixed-variant": "#06513e",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-surface": "#131b2e",
                        "tertiary": "#452900",
                        "primary": "#102579",
                        "surface-bright": "#faf8ff",
                        "on-background": "#131b2e",
                        "surface-container-high": "#e2e7ff",
                        "on-tertiary-fixed": "#2a1700",
                        "secondary-fixed": "#aef0d6",
                        "surface-container-highest": "#dae2fd",
                        "tertiary-container": "#633d00",
                        "tertiary-fixed": "#ffddb8",
                        "primary-fixed": "#dee1ff",
                        "on-secondary": "#ffffff",
                        "surface-container-low": "#f2f3ff",
                        "on-primary-container": "#9faeff",
                        "secondary-container": "#acedd3",
                        "on-primary": "#ffffff",
                        "outline-variant": "#c5c5d3",
                        "inverse-primary": "#b9c3ff",
                        "on-tertiary": "#ffffff",
                        "on-secondary-container": "#2d6e59",
                        "on-error": "#ffffff",
                        "on-tertiary-container": "#f8a00f",
                        "on-error-container": "#93000a",
                        "on-surface-variant": "#454651",
                        "inverse-surface": "#283044",
                        "error-container": "#ffdad6",
                        "on-primary-fixed-variant": "#2e3f91",
                        "outline": "#757683",
                        "on-primary-fixed": "#001258",
                        "secondary-fixed-dim": "#93d4ba",
                        "error": "#ba1a1a",
                        "surface": "#faf8ff",
                        "primary-fixed-dim": "#b9c3ff",
                        "surface-tint": "#4758ab",
                        "inverse-on-surface": "#eef0ff",
                        "secondary": "#286955"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "margin-mobile": "1rem",
                        "stack-md": "1rem",
                        "stack-sm": "0.5rem",
                        "gutter": "1.5rem",
                        "stack-lg": "2rem",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-md": ["Inter"],
                        "headline-sm": ["Inter"],
                        "label-md": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "headline-sm": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-background text-on-surface font-body-md overflow-x-hidden">
    <!-- TopNavBar -->
    <header class="bg-surface sticky top-0 z-50 border-b border-outline-variant shadow-sm">
        <div class="flex justify-between items-center px-gutter py-4 w-full max-w-container-max mx-auto">
            <div class="flex items-center gap-8 flex-1">
                <a class="font-headline-md text-headline-md font-bold text-primary" href="/Home/HomePage">@SiteOptions.Value.BrandName</a>
                <form action="/Home/HomePage" method="get" class="hidden md:flex flex-1 max-w-md relative">
                    <input name="search" value="@ViewBag.SearchTerm" class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-full text-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Tìm kiếm theo tên sách, tác giả..." type="text" />
                    <button type="submit" class="absolute left-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors flex items-center border-none bg-transparent">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </form>
            </div>
            <nav id="home-section-nav" class="hidden lg:flex items-center gap-6 px-8 relative">
                <a data-home-section="home" class="text-primary font-bold py-2 font-body-md transition-colors duration-300" href="/Home/HomePage" aria-current="page">Trang chủ</a>
                <a data-home-section="new-arrivals" class="text-on-surface-variant hover:text-primary py-2 transition-colors duration-300 font-body-md" href="/Home/HomePage#new-arrivals">Sách mới</a>
                <a data-home-section="promotions" class="text-on-surface-variant hover:text-primary py-2 transition-colors duration-300 font-body-md" href="/Home/HomePage#promotions">Khuyến mãi</a>
                <a data-home-section="bestsellers" class="text-on-surface-variant hover:text-primary py-2 transition-colors duration-300 font-body-md" href="/Home/HomePage#bestsellers">Bán chạy</a>
                <span id="home-nav-indicator" class="absolute left-0 bottom-0 h-0.5 bg-primary rounded-full transition-all duration-300 ease-out pointer-events-none" aria-hidden="true"></span>
            </nav>
            <div class="flex items-center gap-4">
                <a href="/Cart" aria-label="Giỏ hàng" class="p-2 text-on-surface-variant hover:text-primary transition-colors relative">
                    <span class="material-symbols-outlined" data-icon="shopping_cart">shopping_cart</span>
                    <span id="header-cart-count" class="absolute top-0 right-0 bg-error text-white text-[10px] min-w-4 h-4 px-1 flex items-center justify-center rounded-full">0</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- User Dropdown -->
                    <div class="relative" id="userDropdown">
                        <button onclick="document.getElementById('userMenu').classList.toggle('hidden')"
                                class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-surface-container transition-colors text-on-surface">
                            <span class="material-symbols-outlined text-primary">account_circle</span>
                            <span class="hidden md:block font-body-md text-body-md font-semibold text-primary max-w-[120px] truncate">@User.Identity.Name</span>
                            <span class="material-symbols-outlined text-[18px] text-outline">expand_more</span>
                        </button>
                        <div id="userMenu" class="hidden absolute right-0 top-full mt-2 w-52 bg-white border border-outline-variant rounded-xl shadow-lg z-50 overflow-hidden">
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Admin/Dashboard" class="flex items-center gap-2 px-4 py-3 text-on-surface hover:bg-surface-container transition-colors font-body-md text-body-md">
                                    <span class="material-symbols-outlined text-[18px] text-primary">admin_panel_settings</span>
                                    Trang quản trị
                                </a>
                                <div class="border-t border-outline-variant"></div>
                            }
                            <a href="/Account/Profile" class="flex items-center gap-2 px-4 py-3 text-on-surface hover:bg-surface-container transition-colors font-body-md text-body-md">
                                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">person</span>
                                Tài khoản của tôi
                            </a>
                            <a href="/Account/OrderHistory" class="flex items-center gap-2 px-4 py-3 text-on-surface hover:bg-surface-container transition-colors font-body-md text-body-md">
                                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">receipt_long</span>
                                Đơn hàng của tôi
                            </a>
                            <div class="border-t border-outline-variant"></div>
                            <form method="post" action="/Account/Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full flex items-center gap-2 px-4 py-3 text-error hover:bg-red-50 transition-colors font-body-md text-body-md">
                                    <span class="material-symbols-outlined text-[18px]">logout</span>
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Login / Register buttons -->
                    <a href="/Account/Login" class="hidden sm:flex items-center gap-1 px-4 py-2 text-primary border border-primary rounded-lg hover:bg-primary hover:text-white transition-all font-body-md text-body-md font-semibold">
                        <span class="material-symbols-outlined text-[18px]">login</span>
                        Đăng nhập
                    </a>
                    <a href="/Account/Register" class="flex items-center gap-1 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-container transition-all font-body-md text-body-md font-semibold">
                        <span class="material-symbols-outlined text-[18px]">person_add</span>
                        <span class="hidden sm:inline">Đăng ký</span>
                    </a>
                }
                <div id="bookverse-language-switcher-slot" class="flex items-center"></div>
            </div>
        </div>
    </header>
    <!-- Secondary Nav (Categories) -->
    <div class="bg-surface-container-lowest border-b border-outline-variant hidden md:block">
        <div class="max-w-container-max mx-auto px-gutter py-3 flex items-center justify-between">
            <ul class="flex gap-8 font-label-md text-label-md text-on-surface-variant flex-wrap">
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (IEnumerable<BookVerse.Models.Category>)ViewBag.Categories)
                    {
                        <li><a class="hover:text-primary transition-colors @(ViewBag.SelectedCategoryId == cat.CategoryId ? "text-primary font-bold border-b-2 border-primary pb-1" : "")" href="/Home/HomePage?categoryId=@cat.CategoryId">@cat.CategoryName</a></li>
                    }
                }
                <li>
                    <a class="hover:text-primary transition-colors font-bold flex items-center gap-1" href="/Home/HomePage">
                        <span class="material-symbols-outlined text-[16px]">apps</span> Tất cả sách
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <main class="max-w-container-max mx-auto pb-stack-lg">
        @if (ViewBag.SearchResults != null || ViewBag.CategoryResults != null)
        {
            var title = ViewBag.SearchResults != null ? $"Kết quả tìm kiếm cho: \"{ViewBag.SearchTerm}\"" : $"Danh mục: {ViewBag.CategoryName}";
            var results = ViewBag.SearchResults != null ? (IEnumerable<BookVerse.Models.Book>)ViewBag.SearchResults : (IEnumerable<BookVerse.Models.Book>)ViewBag.CategoryResults;

            <section class="mt-stack-lg px-gutter min-h-[400px]">
                <div class="flex justify-between items-center mb-stack-md border-b border-outline-variant pb-4">
                    <h2 class="font-headline-md text-headline-md text-primary">@title</h2>
                    <a class="bg-primary-fixed text-on-primary-fixed-variant px-4 py-2 rounded-lg font-bold hover:bg-surface-container transition-all flex items-center gap-2 text-body-md" href="/Home/HomePage">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span> Quay lại trang chủ
                    </a>
                </div>

                @if (!results.Any())
                {
                    <div class="text-center py-16 bg-surface-container-lowest rounded-2xl border border-outline-variant">
                        <span class="material-symbols-outlined text-[80px] text-outline mb-4">search_off</span>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">Không tìm thấy sách nào</h3>
                        <p class="text-on-surface-variant max-w-md mx-auto">Vui lòng thử tìm kiếm với từ khóa khác hoặc quay lại trang chủ.</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-gutter">
                        @foreach (var book in results)
                        {
                            var imgUrl = string.IsNullOrWhiteSpace(book.Image) ? "https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=400&q=80" : book.Image;
                            <div class="book-card-hover group relative bg-white border border-outline-variant rounded-xl p-4 transition-all hover:shadow-lg cursor-pointer book-card"
                                 data-id="@book.BookId"
                                 data-title="@book.Title"
                                 data-author="@book.Author"
                                 data-category="@(book.Category?.CategoryName ?? "Chưa phân loại")"
                                 data-publisher="@(book.Publisher ?? "Đang cập nhật")"
                                 data-price="@string.Format("{0:N0}", book.Price)"
                                 data-image="@imgUrl"
                                 data-quantity="@(book.Quantity ?? 0)"
                                 data-description="@book.Description">
                                <div class="relative mb-4 aspect-[3/4] overflow-hidden rounded-lg bg-surface-container-low">
                                    <img src="@imgUrl" alt="@book.Title" class="w-full h-full object-cover">
                                    <div class="add-to-cart-btn absolute inset-x-0 bottom-0 p-4 opacity-0 transform translate-y-4 transition-all duration-300">
                                        <button class="w-full bg-secondary text-white py-2 rounded-lg font-bold shadow-lg hover:bg-secondary-container hover:text-on-secondary-container transition-colors flex items-center justify-center gap-2" onclick="event.stopPropagation(); addToCart(@book.BookId);">
                                            <span class="material-symbols-outlined text-[18px]">shopping_cart</span> Thêm vào giỏ
                                        </button>
                                    </div>
                                </div>
                                <h3 class="font-bold text-on-surface line-clamp-2 min-h-[40px] mb-1 group-hover:text-primary transition-colors">@book.Title</h3>
                                <p class="text-label-md text-on-surface-variant mb-2">@book.Author</p>
                                <div class="flex items-center gap-1 mb-2">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-[14px] text-tertiary-container filled-icon">star</span>
                                    }
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-primary font-bold">@string.Format("{0:N0}", book.Price)đ</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <!-- Hero Banner Carousel -->
            <section class="mt-stack-md px-gutter">
                <div class="relative h-[400px] rounded-xl overflow-hidden shadow-md group">
                    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="A grand, atmospheric bookstore library with high mahogany shelves reaching the ceiling. Soft morning sunlight streams through large arched windows, illuminating dust motes and highlighting leather-bound spines. The scene is elegant and intellectual, dominated by deep browns, warm amber glows, and hints of navy blue. The wide shot creates a sense of peaceful scholarly abundance." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCEJ6DLI651WmpGDaxDe4hdL6p6M9yBuYOYFc8hUv2UvLhSeB690UZWlqM_PayR3Q6wz8PhyeLmnCWD_EbZ10P5iI3LIhvPIwFHQJhF0lqyMBQV2cwZLpPdu-AaSLVmuMR40mVspyb83Var1wS9pUDG66Wo7qlynleIgQCQMrxrjSLGLToN1fn-fh__-HhG8B_lq2PRIrHirwN0TSvBUVqKqixtPobsFFrABTayluYE-V-KBjnqZyJi')">
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent flex items-center px-12">
                        <div class="max-w-lg text-white">
                            <span class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container rounded-full text-label-md font-bold mb-4">KHUYẾN MÃI THÁNG 10</span>
                            <h1 class="font-headline-lg text-headline-lg mb-4">Ngày hội Văn học: Ưu đãi lên tới 50%</h1>
                            <p class="text-body-lg mb-8 opacity-90">Khám phá kho tàng tri thức từ các tác giả nổi tiếng trên toàn thế giới. Giao hàng miễn phí cho đơn hàng từ 250k.</p>
                            <a href="/Home/HomePage#promotions" class="inline-flex bg-primary text-white px-8 py-3 rounded-lg font-bold hover:bg-primary-container transition-all items-center gap-2">
                                Mua ngay <span class="material-symbols-outlined">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Categories Section -->
            <section class="mt-stack-lg px-gutter">
                <div class="flex justify-between items-end mb-stack-md">
                    <h2 class="font-headline-md text-headline-md text-primary">Danh mục nổi bật</h2>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                    @if (ViewBag.Categories != null)
                    {
                        var catIcons = new Dictionary<string, string>
                        {
                            { "Văn học", "history_edu" },
                            { "Kinh tế", "trending_up" },
                            { "Kỹ năng sống", "psychology" },
                            { "Khoa học Viễn tưởng", "science" }
                        };
                        var catBgClasses = new Dictionary<string, string>
                        {
                            { "Văn học", "bg-primary-fixed" },
                            { "Kinh tế", "bg-secondary-container" },
                            { "Kỹ năng sống", "bg-tertiary-fixed" },
                            { "Khoa học Viễn tưởng", "bg-secondary-container" }
                        };
                        var catIconColorClasses = new Dictionary<string, string>
                        {
                            { "Văn học", "text-primary" },
                            { "Kinh tế", "text-secondary" },
                            { "Kỹ năng sống", "text-on-tertiary-fixed-variant" },
                            { "Khoa học Viễn tưởng", "text-secondary" }
                        };

                        foreach (var cat in (IEnumerable<BookVerse.Models.Category>)ViewBag.Categories)
                        {
                            var iconName = catIcons.ContainsKey(cat.CategoryName!) ? catIcons[cat.CategoryName!] : "menu_book";
                            var bgClass = catBgClasses.ContainsKey(cat.CategoryName!) ? catBgClasses[cat.CategoryName!] : "bg-primary-fixed";
                            var iconColor = catIconColorClasses.ContainsKey(cat.CategoryName!) ? catIconColorClasses[cat.CategoryName!] : "text-primary";

                            <a class="bg-surface-container-low p-6 rounded-xl text-center border border-outline-variant hover:shadow-md hover:-translate-y-1 transition-all" href="/Home/HomePage?categoryId=@cat.CategoryId">
                                <div class="w-12 h-12 @bgClass rounded-full flex items-center justify-center mx-auto mb-4">
                                    <span class="material-symbols-outlined @iconColor text-[28px]">@iconName</span>
                                </div>
                                <span class="font-bold text-on-surface">@cat.CategoryName</span>
                            </a>
                        }
                    }
                </div>
            </section>

            <!-- Sách Nổi Bật / Bán chạy -->
            <section id="bestsellers" class="mt-stack-lg px-gutter scroll-mt-20">
                <div class="flex justify-between items-end mb-stack-md">
                    <h2 class="font-headline-md text-headline-md text-primary">Sách bán chạy</h2>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-gutter">
                    @if (ViewBag.BestSellers != null)
                    {
                        foreach (var book in (IEnumerable<BookVerse.Models.Book>)ViewBag.BestSellers)
                        {
                            var imgUrl = string.IsNullOrWhiteSpace(book.Image) ? "https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=400&q=80" : book.Image;
                            var discountPercent = (book.BookId % 3 == 0) ? 30 : ((book.BookId % 3 == 1) ? 20 : 15);
                            var oldPrice = (book.Price ?? 0) / (1 - (discountPercent / 100m));
                            
                            <div class="book-card-hover group relative bg-white border border-outline-variant rounded-xl p-4 transition-all hover:shadow-lg cursor-pointer book-card"
                                 data-id="@book.BookId"
                                 data-title="@book.Title"
                                 data-author="@book.Author"
                                 data-category="@(book.Category?.CategoryName ?? "Chưa phân loại")"
                                 data-publisher="@(book.Publisher ?? "Đang cập nhật")"
                                 data-price="@string.Format("{0:N0}", book.Price)"
                                 data-image="@imgUrl"
                                 data-quantity="@(book.Quantity ?? 0)"
                                 data-description="@book.Description">
                                <div class="relative mb-4 aspect-[3/4] overflow-hidden rounded-lg bg-surface-container-low">
                                    <img src="@imgUrl" alt="@book.Title" class="w-full h-full object-cover">
                                    <span class="absolute top-2 left-2 bg-error text-white text-[10px] font-bold px-2 py-1 rounded-full">-@discountPercent%</span>
                                    <div class="add-to-cart-btn absolute inset-x-0 bottom-0 p-4 opacity-0 transform translate-y-4 transition-all duration-300">
                                        <button class="w-full bg-secondary text-white py-2 rounded-lg font-bold shadow-lg hover:bg-secondary-container hover:text-on-secondary-container transition-colors flex items-center justify-center gap-2" onclick="event.stopPropagation(); addToCart(@book.BookId);">
                                            <span class="material-symbols-outlined text-[18px]">shopping_cart</span> Thêm vào giỏ
                                        </button>
                                    </div>
                                </div>
                                <h3 class="font-bold text-on-surface line-clamp-2 min-h-[40px] mb-1 group-hover:text-primary transition-colors">@book.Title</h3>
                                <p class="text-label-md text-on-surface-variant mb-2">@book.Author</p>
                                <div class="flex items-center gap-1 mb-2">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-[14px] text-tertiary-container filled-icon">star</span>
                                    }
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-primary font-bold">@string.Format("{0:N0}", book.Price)đ</span>
                                    <span class="text-on-surface-variant text-[12px] line-through">@string.Format("{0:N0}", oldPrice)đ</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>

            <!-- Sách Khuyến Mãi -->
            <section id="promotions" class="mt-stack-lg px-gutter scroll-mt-20">
                <div class="flex justify-between items-end mb-stack-md">
                    <div>
                        <h2 class="font-headline-md text-headline-md text-primary">Khuyến mãi cực hot</h2>
