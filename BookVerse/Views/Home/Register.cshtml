@{
    Layout = null;
}
<!DOCTYPE html>

<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đăng ký - Tiệm Sách Trí Tuệ</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #faf8ff;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container": "#eaedff",
                        "background": "#faf8ff",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-secondary-fixed": "#002117",
                        "surface-variant": "#dae2fd",
                        "surface-container-lowest": "#ffffff",
                        "primary-container": "#2c3e90",
                        "surface-dim": "#d2d9f4",
                        "on-secondary-fixed-variant": "#06513e",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-surface": "#131b2e",
                        "tertiary": "#452900",
                        "primary": "#102579",
                        "surface-bright": "#faf8ff",
                        "on-background": "#131b2e",
                        "surface-container-high": "#e2e7ff",
                        "on-tertiary-fixed": "#2a1700",
                        "secondary-fixed": "#aef0d6",
                        "surface-container-highest": "#dae2fd",
                        "tertiary-container": "#633d00",
                        "tertiary-fixed": "#ffddb8",
                        "primary-fixed": "#dee1ff",
                        "on-secondary": "#ffffff",
                        "surface-container-low": "#f2f3ff",
                        "on-primary-container": "#9faeff",
                        "secondary-container": "#acedd3",
                        "on-primary": "#ffffff",
                        "outline-variant": "#c5c5d3",
                        "inverse-primary": "#b9c3ff",
                        "on-tertiary": "#ffffff",
                        "on-secondary-container": "#2d6e59",
                        "on-error": "#ffffff",
                        "on-tertiary-container": "#f8a00f",
                        "on-error-container": "#93000a",
                        "on-surface-variant": "#454651",
                        "inverse-surface": "#283044",
                        "error-container": "#ffdad6",
                        "on-primary-fixed-variant": "#2e3f91",
                        "outline": "#757683",
                        "on-primary-fixed": "#001258",
                        "secondary-fixed-dim": "#93d4ba",
                        "error": "#ba1a1a",
                        "surface": "#faf8ff",
                        "primary-fixed-dim": "#b9c3ff",
                        "surface-tint": "#4758ab",
                        "inverse-on-surface": "#eef0ff",
                        "secondary": "#286955"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "margin-mobile": "1rem",
                        "stack-md": "1rem",
                        "stack-sm": "0.5rem",
                        "gutter": "1.5rem",
                        "stack-lg": "2rem",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "headline-md": ["Inter"],
                        "headline-sm": ["Inter"],
                        "label-md": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "headline-sm": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}]
                    }
                },
            },
        }
    </script>
</head>
<body class="min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Decorative Animated Background Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary-container/10 blur-[120px]"></div>
        <div class="absolute bottom-[-5%] right-[-5%] w-[30%] h-[30%] rounded-full bg-secondary-container/20 blur-[100px]"></div>
    </div>
    <!-- Main Content Canvas -->
    <main class="flex-grow flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-[480px] z-10">
            <!-- Logo Section -->
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-primary mb-4 shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-white text-[32px]">menu_book</span>
                </div>
                <h2 class="font-headline-lg text-headline-lg text-primary">Tiệm Sách Trí Tuệ</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">Nuôi dưỡng tri thức thông qua từng trang sách.</p>
            </div>
            <!-- Registration Card -->
            <div class="glass-card p-8 rounded-xl shadow-xl border border-outline-variant">
                <h1 class="font-headline-md text-headline-md text-on-surface text-center mb-8">Tạo tài khoản mới</h1>
                <form class="space-y-5" onsubmit="return false">
                    <!-- Họ tên Field -->
                    <div class="space-y-1.5">
                        <label class="font-label-md text-label-md text-on-surface-variant block ml-1 uppercase tracking-wider" for="full_name">Họ tên</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">person</span>
                            <input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-body-md" id="full_name" placeholder="Nguyễn Văn A" type="text" />
                        </div>
                    </div>
                    <!-- Email & SĐT Row -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="font-label-md text-label-md text-on-surface-variant block ml-1 uppercase tracking-wider" for="email">Email</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">mail</span>
                                <input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-body-md" id="email" placeholder="example@gmail.com" type="email" />
                            </div>
                        </div>
                        <div class="space-y-1.5">
                            <label class="font-label-md text-label-md text-on-surface-variant block ml-1 uppercase tracking-wider" for="phone">SĐT</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">call</span>
                                <input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-body-md" id="phone" placeholder="0901234567" type="tel" />
                            </div>
                        </div>
                    </div>
                    <!-- Mật khẩu Field -->
                    <div class="space-y-1.5">
                        <label class="font-label-md text-label-md text-on-surface-variant block ml-1 uppercase tracking-wider" for="password">Mật khẩu</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock</span>
                            <input class="w-full pl-10 pr-12 py-3 bg-white border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-body-md" id="password" placeholder="••••••••" type="password" />
                            <button class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" type="button">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>
                    <!-- Xác nhận Mật khẩu Field -->
                    <div class="space-y-1.5">
                        <label class="font-label-md text-label-md text-on-surface-variant block ml-1 uppercase tracking-wider" for="confirm_password">Xác nhận mật khẩu</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock_reset</span>
                            <input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-body-md" id="confirm_password" placeholder="••••••••" type="password" />
                        </div>
                    </div>
                    <!-- Terms Checkbox -->
                    <div class="flex items-start space-x-3 pt-2">
                        <div class="flex items-center h-5">
                            <input class="w-4 h-4 text-primary border-outline-variant rounded focus:ring-primary/20 cursor-pointer" id="terms" type="checkbox" />
                        </div>
                        <label class="font-body-md text-body-md text-on-surface-variant cursor-pointer" for="terms">
                            Tôi đồng ý với <a class="text-primary hover:underline font-medium" href="#">Điều khoản sử dụng</a> và <a class="text-primary hover:underline font-medium" href="#">Chính sách bảo mật</a> của Tiệm Sách.
                        </label>
                    </div>
                    <!-- Register Button -->
                    <button class="w-full py-4 bg-primary text-white font-headline-sm text-headline-sm rounded-lg shadow-lg shadow-primary/20 hover:bg-primary-container hover:shadow-xl transition-all duration-200 active:scale-[0.98] mt-6" type="submit">
                        Đăng ký
                    </button>
                    <!-- Divider -->
                    <div class="flex items-center my-6">
                        <div class="flex-grow border-t border-outline-variant"></div>
                        <span class="px-4 font-label-md text-label-md text-outline">HOẶC</span>
                        <div class="flex-grow border-t border-outline-variant"></div>
                    </div>
                    <!-- Login Link -->
                    <p class="text-center font-body-md text-body-md text-on-surface-variant">
                        Bạn đã có tài khoản?
                        <a class="text-primary font-bold hover:underline ml-1" href="#">Đăng nhập</a>
                    </p>
                </form>
            </div>
            <!-- Optional Extra: Promotional Grid -->
            <div class="mt-12 grid grid-cols-3 gap-4 opacity-50 select-none grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500">
                <div class="h-40 rounded-lg overflow-hidden relative shadow-md">
                    <div class="bg-cover bg-center w-full h-full" data-alt="A macro shot of vintage book spines lined up on a dark wood shelf, warm sunlight catching the textured paper and leather, creating a cozy and nostalgic literary atmosphere for a premium bookstore." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBg25-i9JjCh2YX-Rf6diHr0QPfDx37URVEjgpemil6VVaXcCgJpohZNhCBJ3CFf3VlhH2zMCyjPpUqSEimyi3D2m-MKpChF5RYnOvP_gnmlYA1HyWTiLTfBf4e71jH45bYLGFZutBK-7AI6r2x7wt7zPGNmp67N7g3emEEkMnX2DWykHvr7o7OQYe6P4x0mg9GwEZyDP3gkK2SnzrBjbPbxmDlFX4E9X8TH4MSUHTn3pxmremg22yT')"></div>
                </div>
                <div class="h-40 rounded-lg overflow-hidden relative shadow-md -translate-y-4">
                    <div class="bg-cover bg-center w-full h-full" data-alt="A modern, high-end minimalist library interior with floor-to-ceiling bookshelves, clean white architectural lines, and large windows revealing a soft blue dusk sky, reflecting intellectual clarity and peace." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCGbdJXbzxIyFtz4V1Evp-AJT0k6UzRjhJP9wY7Heyz2hPyXV0sC-632DIyia3VsuVo2FWOUZP52TjzStegnC3lkIbZw_kc2OX5P_gNspde5EzlqiJMdBROeSX6aXNN6_Fg7VXJ1U38RsjrQPhNa53IaE7xmh6yKPaxmquhakPfbk4lAsN2XA3aJjUKOY3G4NdrvEy8sjJK-D4MwsB8zhrHk8TgHElqqlq70MEtX5V0yCxbtXyPZ7jq')"></div>
                </div>
                <div class="h-40 rounded-lg overflow-hidden relative shadow-md">
                    <div class="bg-cover bg-center w-full h-full" data-alt="An artistic flat lay of an open book with a steaming cup of coffee on a textured linen surface, surrounded by soft dried flower petals, evoking the sensory pleasure of reading in a quiet morning setting." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDrtw-iCMimsghRI-5MtwblQpbyrULL7N8SDDwXHWg6ER2DovocpgZSGvTSPVSObLfhnKtvGKKlw-AnaBQi50Y2zhyY7xiilAR8EFxCAYBQZWwESoRnIdgPsAte11AykkMQ42_4I_V5UzIzNaCDRgExzxYuDXeZnO3OTgibjEainmu2AR-jscIAT2PLoPurX6TkrVZtacw7XXDs2m2e6uxiz5ZPi760q2NL7eLkOv_0OFlViq4hObMQ')"></div>
                </div>
            </div>
        </div>
    </main>
    <!-- Footer -->
    <footer class="w-full py-8 px-gutter flex flex-col md:flex-row justify-between items-center gap-4 text-on-surface-variant font-body-md text-body-md">
        <p>© 2024 Tiệm Sách Trí Tuệ. All rights reserved.</p>
        <div class="flex gap-6">
            <a class="hover:text-primary transition-colors" href="#">Về chúng tôi</a>
            <a class="hover:text-primary transition-colors" href="#">Hỗ trợ</a>
            <a class="hover:text-primary transition-colors" href="#">Liên hệ</a>
        </div>
    </footer>
    <!-- Micro-interactions Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const togglePassword = document.querySelector('button span:contains("visibility")')?.parentElement;
            const passwordInput = document.getElementById('password');

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', () => {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    togglePassword.querySelector('span').textContent = type === 'password' ? 'visibility' : 'visibility_off';
                });
            }

            // Simple reveal animation for card
            const card = document.querySelector('.glass-card');
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = 'all 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, 100);
        });

        // Custom selector for text content since vanilla JS doesn't have :contains
        window.addEventListener('load', () => {
             const spans = document.querySelectorAll('.material-symbols-outlined');
             spans.forEach(span => {
                 if (span.textContent.trim() === 'visibility') {
                    span.parentElement.addEventListener('click', (e) => {
                        const input = span.parentElement.previousElementSibling;
                        if (input.type === 'password') {
                            input.type = 'text';
                            span.textContent = 'visibility_off';
                        } else {
                            input.type = 'password';
                            span.textContent = 'visibility';
                        }
                    });
                 }
             });
        });
    </script>
</body>
</html>