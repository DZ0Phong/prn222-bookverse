<!DOCTYPE html>
<html lang="@(Context.Request.Cookies["bookverse.culture"] ?? "vi")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @SiteOptions.Value.BrandName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
<header class="bg-white border-bottom sticky-top"><nav class="navbar navbar-expand-lg container py-3">
    <a class="navbar-brand fw-bold text-primary" href="/">@SiteOptions.Value.BrandName</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
    <div id="mainNav" class="collapse navbar-collapse"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" href="/">@T["Common.Home"]</a></li>@if(User.Identity?.IsAuthenticated==true){<li class="nav-item"><a class="nav-link" href="/Account/OrderHistory">@T["Order.History"]</a></li>}</ul>
    <div class="d-flex align-items-center gap-2"><a class="btn btn-outline-primary position-relative" href="/Cart"><i class="bi bi-cart3"></i> @T["Common.Cart"] <span id="cart-count" class="badge bg-danger rounded-pill">0</span></a>
    @if(User.Identity?.IsAuthenticated==true){<a class="btn btn-link" href="/Account/Profile">@User.Identity.Name</a><form action="/Account/Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-link">Đăng xuất</button></form>}else{<a class="btn btn-link" href="/Account/Login">Đăng nhập</a><a class="btn btn-primary" href="/Account/Register">Đăng ký</a>}
    <form action="/Localization/SetLanguage" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><button class="btn btn-sm btn-outline-secondary" name="culture" value="vi">VI</button><button class="btn btn-sm btn-outline-secondary" name="culture" value="en">EN</button></form></div></div>
</nav></header>
<main class="container py-4">@RenderBody()</main>
<footer class="bg-white border-top mt-5 py-4"><div class="container d-flex flex-wrap justify-content-between gap-3 small text-muted"><span>© @DateTime.Now.Year @SiteOptions.Value.BrandName</span><span>@SiteOptions.Value.SupportEmail · @SiteOptions.Value.Hotline · @SiteOptions.Value.Address</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/localization.js" asp-append-version="true"></script>
<script>fetch('/Cart/Count').then(r=>r.json()).then(x=>document.getElementById('cart-count').textContent=x.count).catch(()=>{});</script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
