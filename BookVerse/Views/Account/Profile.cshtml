@model BookVerse.Models.ViewModels.ProfileViewModel
@{ ViewData["Title"] = "Tài khoản của tôi"; }

<div class="row justify-content-center"><div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Tài khoản của tôi</h1><p class="text-muted mb-0">Xem và cập nhật thông tin dùng khi đặt hàng.</p></div><a class="btn btn-outline-primary" href="/Account/ChangePassword">Đổi mật khẩu</a></div>
    @if (TempData["ProfileSuccess"] is string message) { <div class="alert alert-success">@message</div> }
    <form method="post" class="card shadow-sm"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
        <div class="col-md-6"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" readonly/><div class="form-text">Email đăng nhập không thay đổi tại đây.</div></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger"></span></div>
        <div class="col-md-6"><label class="form-label">Ngày tạo tài khoản</label><input class="form-control" value="@Model.CreatedAt?.ToString("dd/MM/yyyy")" readonly/></div>
        <div class="col-12"><label asp-for="Address" class="form-label">Địa chỉ nhận hàng mặc định</label><textarea asp-for="Address" class="form-control" rows="3"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
    </div></div><div class="card-footer text-end"><button class="btn btn-primary" type="submit">Lưu thay đổi</button></div></form>
    <div class="mt-3"><a href="/Account/OrderHistory">Xem lịch sử mua hàng</a></div>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
