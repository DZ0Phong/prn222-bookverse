@model BookVerse.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="@(Context.Request.Cookies["bookverse.culture"] ?? "en")">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@T["Auth.LoginTitle"] | @SiteOptions.Value.BrandName</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container": "#eaedff",
                        "background": "#faf8ff",
                        "surface-variant": "#dae2fd",
                        "surface-container-lowest": "#ffffff",
                        "primary-container": "#2c3e90",
                        "on-surface": "#131b2e",
                        "primary": "#102579",
                        "surface-bright": "#faf8ff",
                        "on-background": "#131b2e",
                        "on-primary": "#ffffff",
                        "outline-variant": "#c5c5d3",
                        "on-surface-variant": "#454651",
                        "outline": "#757683",
                        "secondary": "#286955",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    "spacing": { "margin-mobile": "1rem", "stack-md": "1rem", "stack-sm": "0.5rem", "gutter": "1.5rem", "stack-lg": "2rem" },
                    "fontFamily": { "headline-lg": ["Inter"], "body-lg": ["Inter"], "body-md": ["Inter"], "headline-md": ["Inter"], "headline-sm": ["Inter"], "label-md": ["Inter"] },
                    "fontSize": {
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "headline-sm": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #faf8ff; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .glass-card { background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.3); }
        .login-mesh-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; }
    </style>
</head>
<body class="flex flex-col min-h-screen">
    <main class="flex-grow flex items-center justify-center px-margin-mobile relative overflow-hidden py-10">
        <div class="login-mesh-bg">
            <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-primary opacity-10 blur-[120px] rounded-full"></div>
            <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-secondary opacity-10 blur-[120px] rounded-full"></div>
        </div>

        <div class="w-full max-w-[440px] glass-card shadow-lg rounded-xl p-8 md:p-10">
            <!-- Brand -->
            <div class="flex flex-col items-center mb-8">
                <div class="w-14 h-14 bg-primary rounded-lg flex items-center justify-center mb-4 shadow-md">
                    <span class="material-symbols-outlined text-on-primary text-[32px]">menu_book</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-primary tracking-tight">@SiteOptions.Value.BrandName</h1>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">@T["Auth.WelcomeBack"]</p>
            </div>

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
            {
                <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg flex items-center gap-2">
                    <span class="material-symbols-outlined text-error text-[20px]">error</span>
                    <p class="font-body-md text-body-md text-error">@Model.ErrorMessage</p>
                </div>
            }

            <!-- Login Form -->
            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model?.ReturnUrl" method="post" class="space-y-stack-md" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <h2 class="font-headline-sm text-headline-sm text-on-surface mb-6">@T["Auth.LoginTitle"]</h2>

                <!-- Email -->
                <div class="space-y-1.5">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" for="Email">@T["Auth.Email"]</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">mail</span>
                        <input asp-for="Email" class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md text-body-md outline-none" placeholder="example@gmail.com" type="email" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-error text-xs"></span>
                </div>

                <!-- Password -->
                <div class="space-y-1.5">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" for="Password">@T["Auth.Password"]</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">lock</span>
                        <input asp-for="Password" id="passwordInput" class="w-full pl-10 pr-12 py-3 bg-white border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md text-body-md outline-none" placeholder="••••••••" type="password" autocomplete="current-password" />
                        <button class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors focus:outline-none" id="togglePassword" type="button">
                            <span class="material-symbols-outlined text-[20px]" id="eyeIcon">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-error text-xs"></span>
                </div>

                <!-- Submit -->
                <button id="submitBtn" class="w-full bg-primary text-on-primary py-3.5 rounded-lg font-headline-sm text-headline-sm hover:bg-primary-container hover:shadow-md active:scale-95 transition-all duration-200 mt-2" type="submit">
                    @T["Auth.LoginTitle"]
                </button>
            </form>

            <!-- Divider -->
            <div class="relative flex items-center py-6">
                <div class="flex-grow border-t border-outline-variant"></div>
                <span class="flex-shrink mx-4 font-label-md text-label-md text-outline">@T["Auth.Or"]</span>
                <div class="flex-grow border-t border-outline-variant"></div>
            </div>

            <!-- Register link -->
            <div class="text-center">
                <p class="font-body-md text-body-md text-on-surface-variant">
                    @T["Auth.NoAccount"]
                    <a class="text-secondary font-bold hover:underline transition-all ml-1" href="/Account/Register?returnUrl=@Uri.EscapeDataString(Model?.ReturnUrl ?? string.Empty)">@T["Auth.RegisterNow"]</a>
                </p>
            </div>
        </div>
    </main>

    <footer class="py-6 text-center">
        <p class="font-label-md text-label-md text-outline">© @DateTime.Now.Year @SiteOptions.Value.BrandName. All rights reserved.</p>
    </footer>

    <script>
        // Password toggle
        document.getElementById('togglePassword').addEventListener('click', function() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.textContent = input.type === 'password' ? 'visibility' : 'visibility_off';
        });

        // Loading state on submit
        document.getElementById('loginForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span>';
        });

        // Parallax
        document.addEventListener('mousemove', (e) => {
            const x = e.clientX / window.innerWidth;
            const y = e.clientY / window.innerHeight;
            const mesh = document.querySelector('.login-mesh-bg');
            if (mesh) mesh.style.transform = `translate(${x * 10}px, ${y * 10}px)`;
        });
    </script>
    <script src="~/js/localization.js" asp-append-version="true"></script>
</body>
</html>
