@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Không có quyền truy cập | @SiteOptions.Value.BrandName</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="min-h-screen bg-[#faf8ff] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-red-100 mb-6">
            <span class="material-symbols-outlined text-[48px] text-red-500">lock</span>
        </div>
        <h1 class="text-3xl font-bold text-[#102579] mb-4">Không có quyền truy cập</h1>
        <p class="text-gray-600 text-base mb-2">Bạn không có quyền truy cập vào trang này.</p>
        <p class="text-gray-500 text-sm mb-8">Vui lòng đăng nhập bằng tài khoản có đủ quyền hạn hoặc liên hệ quản trị viên.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-[#102579] text-white rounded-lg font-semibold hover:bg-[#2c3e90] transition-colors">
                <span class="material-symbols-outlined text-[20px]">home</span>
                Về trang chủ
            </a>
            <a href="/Account/Login" class="inline-flex items-center gap-2 px-6 py-3 border border-[#102579] text-[#102579] rounded-lg font-semibold hover:bg-blue-50 transition-colors">
                <span class="material-symbols-outlined text-[20px]">login</span>
                Đăng nhập
            </a>
        </div>
    </div>
    <script src="~/js/localization.js" asp-append-version="true"></script>
</body>
</html>
