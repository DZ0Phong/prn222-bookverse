@model BookVerse.Models.ViewModels.User.CartViewModel
@{ ViewData["Title"] = T["Cart.Title"]; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3">@T["Cart.Title"]</h1><a class="btn btn-outline-secondary" href="/">@T["Common.ContinueShopping"]</a></div>
@if(TempData["SuccessKey"] is string successKey){<div class="alert alert-success">@T[successKey]</div>}
@if(!Model.Items.Any()){<div class="card card-body text-center py-5"><i class="bi bi-cart-x fs-1"></i><p>@T["Cart.Empty"]</p></div>}
else{
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>@T["Order.Items"]</th><th>@T["Common.Price"]</th><th>@T["Common.Quantity"]</th><th>@T["Common.Total"]</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td><div class="d-flex align-items-center gap-3"><img src="@(item.Image ?? "/favicon.ico")" width="54" height="70" style="object-fit:cover" alt=""/><a href="/User/Book/Detail/@item.BookId">@item.Title</a></div></td><td>@item.Price.ToString("N0") ₫</td><td><form action="/Cart/Update" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="cartId" value="@item.CartId"/><input class="form-control" style="width:85px" type="number" name="quantity" value="@item.Quantity" min="1" max="@item.Stock"/><button class="btn btn-outline-primary">@T["Common.Update"]</button></form></td><td class="fw-bold">@item.Subtotal.ToString("N0") ₫</td><td><form action="/Cart/Remove" method="post">@Html.AntiForgeryToken()<input type="hidden" name="cartId" value="@item.CartId"/><button class="btn btn-outline-danger">@T["Common.Remove"]</button></form></td></tr>}
</tbody></table></div></div><div class="card card-body mt-3 ms-auto" style="max-width:420px"><div class="d-flex justify-content-between h5"><span>@T["Common.Subtotal"]</span><strong>@Model.Subtotal.ToString("N0") ₫</strong></div>@if(User.Identity?.IsAuthenticated == true){<a href="/Checkout" class="btn btn-primary btn-lg mt-2">@T["Common.Checkout"]</a>}else{<button type="button" class="btn btn-primary btn-lg mt-2" data-bs-toggle="modal" data-bs-target="#loginRequiredModal">@T["Common.Checkout"]</button>}</div>}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-labelledby="loginRequiredTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="loginRequiredTitle">Đăng nhập để thanh toán</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body">Giỏ hàng của bạn sẽ được giữ nguyên. Vui lòng đăng nhập hoặc đăng ký tài khoản để tiếp tục đặt hàng.</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tiếp tục xem giỏ</button><a class="btn btn-outline-primary" href="/Account/Register?returnUrl=%2FCheckout">Đăng ký</a><a class="btn btn-primary" href="/Account/Login?returnUrl=%2FCheckout">Đăng nhập</a></div></div></div></div>
}
