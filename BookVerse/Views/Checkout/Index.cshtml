@model BookVerse.Models.ViewModels.User.CheckoutViewModel
@{ ViewData["Title"] = T["Checkout.Title"]; }
<h1 class="h3 mb-4">@T["Checkout.Title"]</h1>
<form action="/Checkout/PlaceOrder" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger mb-3"></div><div class="row g-4"><div class="col-lg-7"><div class="card card-body shadow-sm">
<label class="form-label">@T["Checkout.Address"]</label><textarea asp-for="ShippingAddress" class="form-control mb-3" rows="3"></textarea><label class="form-label">@T["Checkout.Phone"]</label><input asp-for="PhoneNumber" class="form-control mb-3"/><label class="form-label">@T["Checkout.Voucher"]</label><div class="input-group mb-2"><input asp-for="VoucherCode" class="form-control"/><button type="button" id="apply-voucher" class="btn btn-outline-primary">@T["Common.Apply"]</button></div><div id="voucher-message" class="small mb-3"></div><label class="form-label">@T["Checkout.PaymentMethod"]</label>
@if(Model.EnableCod){<label class="form-check"><input class="form-check-input" type="radio" asp-for="PaymentMethod" value="COD" checked/> @T["Checkout.Cod"]</label>}@if(Model.EnableVnPay){<label class="form-check"><input class="form-check-input" type="radio" asp-for="PaymentMethod" value="VNPAY" disabled="@(!Model.VnPayConfigured)"/> @T["Checkout.VnPay"] @if(!Model.VnPayConfigured){<span class="badge bg-warning text-dark">@T["Checkout.VnPayNotConfigured"]</span>}</label>}
</div></div><div class="col-lg-5"><div class="card card-body shadow-sm">@foreach(var item in Model.Cart.Items){<div class="d-flex justify-content-between mb-2"><span>@item.Title × @item.Quantity</span><span>@item.Subtotal.ToString("N0") ₫</span></div>}<hr/><div class="d-flex justify-content-between"><span>@T["Common.Subtotal"]</span><span>@Model.Cart.Subtotal.ToString("N0") ₫</span></div><div class="d-flex justify-content-between"><span>@T["Common.Discount"]</span><span id="discount">-@Model.DiscountAmount.ToString("N0") ₫</span></div><div class="d-flex justify-content-between"><span>@T["Common.Shipping"]</span><span id="shipping">@Model.ShippingFee.ToString("N0") ₫</span></div><hr/><div class="d-flex justify-content-between h5"><span>@T["Common.Total"]</span><strong id="grand-total">@Model.GrandTotal.ToString("N0") ₫</strong></div><button class="btn btn-primary btn-lg mt-3">@T["Checkout.PlaceOrder"]</button></div></div></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>const invalidVoucherMessage=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Checkout.InvalidVoucher"]));document.getElementById('apply-voucher').addEventListener('click',async()=>{const fd=new FormData();fd.append('code',document.getElementById('VoucherCode').value);fd.append('__RequestVerificationToken',document.querySelector('input[name=__RequestVerificationToken]').value);const x=await(await fetch('/Checkout/ApplyVoucher',{method:'POST',body:fd})).json();const m=document.getElementById('voucher-message');m.textContent=x.success?'✓ '+x.discountPercent+'%':invalidVoucherMessage;m.className=x.success?'small text-success mb-3':'small text-danger mb-3';if(x.success){const f=n=>new Intl.NumberFormat('vi-VN').format(n)+' ₫';document.getElementById('discount').textContent='-'+f(x.discountAmount);document.getElementById('shipping').textContent=f(x.shippingFee);document.getElementById('grand-total').textContent=f(x.grandTotal);}});</script>}
